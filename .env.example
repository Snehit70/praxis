# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Clerk auth (https://dashboard.clerk.com -> API Keys) ---
# Frontend (public, safe to expose in the bundle):
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Backend (SECRET — never commit, never expose to the client):
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Backend (Bun API) ---
DATABASE_URL=postgres://praxis:praxis@127.0.0.1:5432/praxis
# Frontend origin allowed for CORS + Clerk authorizedParties (auth routes):
API_ALLOWED_ORIGIN=http://localhost:5173
# Comma-separated trusted socket peers. Deployment sets Docker's gateway.
API_TRUSTED_PROXY_IPS=
# Optional selective verification. Set all three together on the backend only.
# TURNSTILE_SITE_KEY=<widget site key>
# TURNSTILE_SECRET_KEY=<widget secret key>
# TURNSTILE_HOSTNAME=praxis.snehit70.dev

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://127.0.0.1:8787
