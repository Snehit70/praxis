{
  "name": "quiz",
  "version": "0.11.0",
  "module": "index.ts",
  "scripts": {
    "dev": "vite",
    "api": "bun run server/index.ts",
    "db:import": "bun run server/import-db.ts",
    "db:trial": "bun run scripts/db-provider-trial.ts",
    "build": "tsc -b && vite build",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test --preload ./test/setup-dom.ts ./src",
    "test:api": "bun test ./server/app.test.ts ./server/paperPdf.test.ts ./server/pdfGuard.test.ts",
    "test:integration": "bun test ./server/app.test.ts",
    "lint": "eslint src server vite.config.ts",
    "preview": "vite preview",
    "proto:paper-pdf": "bun run scripts/prototype-paper-pdf.ts"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.10.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@clerk/backend": "^3.4.12",
    "@clerk/clerk-react": "^5.61.3",
    "@clerk/themes": "^2.4.57",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource/instrument-serif": "^5.2.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.564.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0"
  }
}
